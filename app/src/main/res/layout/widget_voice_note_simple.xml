<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background_simple"
    android:padding="4dp">

    <!-- Simple 1x1 widget with proper sized button -->
    <FrameLayout
        android:id="@+id/recordButton"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true">

        <!-- Recording state: Show STOP button -->
        <ImageView
            android:id="@+id/stopIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_stop_square"
            android:contentDescription="Stop Recording"
            android:visibility="gone" />

        <!-- Idle state: Show mic icon -->
        <ImageView
            android:id="@+id/micIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_mic"
            android:contentDescription="Voice Record" />

        <!-- Status indicator (small dot) -->
        <ImageView
            android:id="@+id/statusIndicator"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="top|end"
            android:layout_margin="2dp"
            android:src="@drawable/status_indicator_idle"
            android:visibility="gone" />

    </FrameLayout>

</FrameLayout>